{
  "name": "k6-performance-testing-framework",
  "version": "1.0.0",
  "description": "Enterprise Modular K6 Performance Testing Framework",
  "main": "k6-performance/tests/smoke/crud.smoke.js",
  "scripts": {
    "test:smoke": "k6 run k6-performance/tests/smoke/crud.smoke.js",
    "test:smoke:staging": "k6 run -e ENV=staging k6-performance/tests/smoke/crud.smoke.js",
    "test:load": "k6 run k6-performance/tests/load/crud.load.js",
    "test:load:staging": "k6 run -e ENV=staging k6-performance/tests/load/crud.load.js",
    "test:stress": "k6 run k6-performance/tests/stress/crud.stress.js",
    "test:spike": "k6 run k6-performance/tests/spike/crud.spike.js",
    "test:soak": "k6 run k6-performance/tests/soak/crud.soak.js",
    "test:breakpoint": "k6 run k6-performance/tests/breakpoint/crud.breakpoint.js",
    "test:individual:get": "k6 run -e WORKLOAD_MODE=individual -e OPERATION=get k6-performance/tests/smoke/crud.smoke.js",
    "test:individual:post": "k6 run -e WORKLOAD_MODE=individual -e OPERATION=post k6-performance/tests/smoke/crud.smoke.js",
    "test:workflow": "k6 run -e WORKLOAD_MODE=workflow k6-performance/tests/load/crud.load.js",
    "test:mixed": "k6 run -e WORKLOAD_MODE=mixed -e WEIGHT_GET=70 -e WEIGHT_POST=15 -e WEIGHT_PUT=10 -e WEIGHT_DELETE=5 k6-performance/tests/load/crud.load.js",
    "docker:smoke": "docker-compose run --rm k6-smoke",
    "docker:load": "docker-compose run --rm k6-load",
    "docker:stress": "docker-compose run --rm k6-stress",
    "docker:spike": "docker-compose run --rm k6-spike",
    "docker:soak": "docker-compose run --rm k6-soak",
    "docker:breakpoint": "docker-compose run --rm k6-breakpoint",
    "grafana:up": "docker-compose up -d influxdb grafana",
    "grafana:down": "docker-compose stop influxdb grafana",
    "test:smoke:grafana": "k6 run -o influxdb=http://localhost:8086/k6 k6-performance/tests/smoke/crud.smoke.js",
    "test:load:grafana": "k6 run -o influxdb=http://localhost:8086/k6 k6-performance/tests/load/crud.load.js",
    "clean:reports": "node -e \"const fs=require('fs'); ['html','json','summary'].forEach(d => { const p='k6-performance/reports/'+d; fs.rmSync(p, {recursive: true, force: true}); fs.mkdirSync(p, {recursive: true}); });\"",
    "agent:setup": "node agent/cli.js setup",
    "agent:scan": "node agent/cli.js scan",
    "agent:generate": "node agent/cli.js generate",
    "agent:validate": "node agent/cli.js validate",
    "agent:run:smoke": "node agent/cli.js run smoke",
    "agent:run:load": "node agent/cli.js run load",
    "agent:analyze": "node agent/cli.js analyze",
    "agent:auto": "node agent/cli.js auto"
  },
  "keywords": [
    "k6",
    "performance-testing",
    "load-testing",
    "stress-testing",
    "spike-testing",
    "soak-testing",
    "breakpoint-testing",
    "devops",
    "ci-cd"
  ],
  "author": "Senior Performance Engineer & K6 Framework Architect",
  "license": "ISC"
}
