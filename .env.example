# ==============================================================================
# K6 Performance Testing Framework Environment Configuration Template
# Copy this file to .env or pass these as -e KEY=VALUE to k6 run
# ==============================================================================

# Target Environment: dev | staging | production
ENV=dev
TARGET_ENV=dev

# Base URL override (Leave empty to use environment config default)
# BASE_URL=https://staging-api.yourdomain.com
BASE_URL=

# Authentication Settings
# Direct Bearer token override (bypasses login API call)
# AUTH_TOKEN=eyJh...
AUTH_TOKEN=

# Login API credentials (used when AUTH_TOKEN is not provided)
USERNAME=emilys
PASSWORD=emilyspass

# Request Settings
REQUEST_TIMEOUT=15s
LOG_LEVEL=INFO

# Test Workload & Concurrency Overrides
# VUS=20
# DURATION=3m
# SOAK_DURATION=30m

# Workload Model: mixed | workflow | individual
WORKLOAD_MODE=mixed

# Mixed Workload Operation Distribution Percentages (Must sum to 100)
WEIGHT_GET=70
WEIGHT_POST=15
WEIGHT_PUT=10
WEIGHT_DELETE=5

# Cleanup Configuration: true | false
CLEANUP_ENABLED=true
